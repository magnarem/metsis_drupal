<?php

/**
 * @file
 * METSIS module.
 */

declare(strict_types=1);

use Drupal\Component\Utility\Html;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\views\ViewExecutable;
use Drupal\views\Plugin\views\cache\CachePluginBase;

/**
 * Implements hook_help().
 */
function metsis_drupal_help($route_name, RouteMatchInterface $route_match): string {
  switch ($route_name) {
    case 'help.page.metsis_drupal':
      $text = file_get_contents(__DIR__ . '/README.md');
      if ($text === FALSE) {
        return '';
      }

      if (!\Drupal::moduleHandler()->moduleExists('markdown')) {
        return '<pre>' . Html::escape($text) . '</pre>';
      }
      else {
        // Use the Markdown filter to render the README.
        $filter_manager = \Drupal::service('plugin.manager.filter');
        $settings = \Drupal::configFactory()->get('markdown.settings')->getRawData();
        $config = ['settings' => $settings];
        /** @var \Drupal\filter\Plugin\FilterInterface */
        $filter = $filter_manager->createInstance('markdown', $config);
        return (string) $filter->process($text, 'en');
      }
  }
  return '';
}

/**
 * Implements hook_views_pre_build().
 */
function metsis_drupal_views_pre_build(ViewExecutable $view) {
  if ($view->id() !== 'metsis_search') {
    return;
  }
  // -- PROFILING: record wall-clock start for the full Views lifecycle.
  $GLOBALS['_metsis_views_t_pre_build'] = hrtime(TRUE);
}

/**
 * Implements hook_views_pre_execute().
 */
function metsis_drupal_views_pre_execute(ViewExecutable $view): void {
  if ($view->id() !== 'metsis_search') {
    return;
  }
  $GLOBALS['_metsis_views_t_pre_execute'] = hrtime(TRUE);
}

/**
 * Implements hook_views_post_execute().
 */
function metsis_drupal_views_post_execute(ViewExecutable $view): void {
  if ($view->id() !== 'metsis_search') {
    return;
  }
  $t_pre_build                             = $GLOBALS['_metsis_views_t_pre_build'] ?? hrtime(TRUE);
  $t_pre_execute                           = $GLOBALS['_metsis_views_t_pre_execute'] ?? hrtime(TRUE);
  $now                                     = hrtime(TRUE);
  $GLOBALS['_metsis_views_t_post_execute'] = $now;
  \Drupal::logger('metsis_row_profiler')->debug(
    'Views execute: build=@build ms | execute=@execute ms | rows=@rows',
    [
      '@build'   => round(($t_pre_execute - $t_pre_build) / 1e6, 1),
      '@execute' => round(($now - $t_pre_execute) / 1e6, 1),
      '@rows'    => count($view->result),
    ]
  );
}

/**
 * Implements hook_views_pre_render().
 */
function metsis_drupal_views_pre_render(ViewExecutable $view): void {
  if ($view->id() !== 'metsis_search') {
    return;
  }
  $GLOBALS['_metsis_views_t_pre_render'] = hrtime(TRUE);
  $t_post_execute = $GLOBALS['_metsis_views_t_post_execute'] ?? hrtime(TRUE);
  \Drupal::logger('metsis_row_profiler')->debug(
    'Views pre_render: gap since post_execute=@gap ms',
    ['@gap' => round((hrtime(TRUE) - $t_post_execute) / 1e6, 1)]
  );
}

/**
 * Implements hook_views_post_render().
 */
function metsis_drupal_views_post_render(ViewExecutable $view, array &$output, CachePluginBase $cache): void {
  if ($view->id() === 'metsis_search') {
    $t_pre_render = $GLOBALS['_metsis_views_t_pre_render'] ?? hrtime(TRUE);
    $t_pre_build  = $GLOBALS['_metsis_views_t_pre_build'] ?? hrtime(TRUE);
    \Drupal::logger('metsis_row_profiler')->debug(
      'Views post_render: render=@render ms | total_views=@total ms',
      [
        '@render' => round((hrtime(TRUE) - $t_pre_render) / 1e6, 1),
        '@total'  => round((hrtime(TRUE) - $t_pre_build) / 1e6, 1),
