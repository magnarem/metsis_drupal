declare(strict_types=1);

use Drupal\views\Plugin\views\filter\FilterPluginBase;
use Drupal\Component\Utility\Html;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\views\ViewExecutable;
use Drupal\views\Plugin\views\cache\CachePluginBase;

/**
 * Implements hook_help().
 */
function metsis_drupal_help($route_name, RouteMatchInterface $route_match): string {
  switch ($route_name) {
    case 'help.page.metsis_drupal':
      $text = file_get_contents(__DIR__ . '/README.md');
      if ($text === FALSE) {
        return '';
      }

      if (!\Drupal::moduleHandler()->moduleExists('markdown')) {
        return '<pre>' . Html::escape($text) . '</pre>';
      }
      else {
        // Use the Markdown filter to render the README.
        $filter_manager = \Drupal::service('plugin.manager.filter');
        $settings = \Drupal::configFactory()->get('markdown.settings')->getRawData();
        $config = ['settings' => $settings];
        /** @var \Drupal\filter\Plugin\FilterInterface */
        $filter = $filter_manager->createInstance('markdown', $config);
        return (string) $filter->process($text, 'en');
      }
  }
  return '';
}

/**
 * Implements hook_views_filters_summary_info_alter().
 */
function metsis_drupal_views_filters_summary_info_alter(array &$info, FilterPluginBase $filter) {
  // Handle custom summary for custom bbox filter.
  if ($filter->getPluginId() === 'metsis_filter_bbox' && !empty($filter->value)) {
    if (!$filter->value['minX'] == '') {
      // Format each value: 3 decimals for floats, as-is for ints.
      $formatted_values = array_map(function ($v) {
        return is_float($v + 0) ? number_format((float) $v, 3, '.', '') : (string) $v;
      }, $filter->value);

      $info['value'][0] = [
        'id' => 0,
        'raw' => 'bbox',
        'value' => ucfirst($filter->operator) . '(' . implode(', ', $formatted_values) . ')',
      ];
    }
  }
}

/**
 * Implements hook_views_filters_summary_filter_value_alter().
 */
function metsis_drupal_views_filters_summary_filter_value_alter(
  mixed &$value,
  FilterPluginBase $filter,
) {

  // For some reason, the User Permissions plugin does not properly
  // populate the filter value.
  if ($filter->getPluginId() === 'metsis_filter_bbox') {
    $inputs = $filter->view->getExposedInput();
    $value = $inputs[$filter->options['id']];
  }
}

