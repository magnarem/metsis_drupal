<?php

/**
 * @file
 * Install, update and uninstall functions for the METISIS module.
 */

declare(strict_types=1);

use Drupal\metsis_drupal\MetsisConstants;

/**
 * Implements hook_install().
 */
function metsis_drupal_install(): void {
  module_set_weight('metsis_drupal', 1);
  user_role_grant_permissions('anonymous', ['access metsis metadata export']);
}

/**
 * Implements hook_uninstall().
 *
 * Deletes Search API server and index configurations created by this module.
 */
function metsis_drupal_uninstall() {

  // Delete the metsis solr index configuration.
  $config_factory = \Drupal::configFactory();
  $config = $config_factory->getEditable("search_api.index." . MetsisConstants::METSIS_SOLR_INDEX_ID);
  $config->delete();

  // Delete the metsis_solr Search API Solr server configuration.
  $config_factory = \Drupal::configFactory();
  $config = $config_factory->getEditable("search_api.server." . MetsisConstants::METSIS_SOLR_SERVER_ID);
  $config->delete();

  // Delete the Search API index if it exists.
  // if ($index = $index_storage->load($custom_index_id)) {
  // $index->delete();
  // }
}

/**
 * Converts search block exclusions into explicit visible element selections.
 */
function metsis_drupal_update_11001(): void {
  $entity_type_manager = \Drupal::entityTypeManager();
  if (!$entity_type_manager->hasDefinition('block')) {
    return;
  }
  $storage = $entity_type_manager->getStorage('block');
  foreach ($storage->loadMultiple() as $block) {
    if ($block->getPluginId() === 'metsis_search_exposed_form'
      && array_key_exists('disabled_filters', $block->get('settings'))) {
      $block->set('settings', $block->getPlugin()->getConfiguration());
      $block->save();
    }
  }
}
