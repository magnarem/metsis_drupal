{#
/**
 * @file
 * Theme override for a facets item list.
 *
 * Available variables:
 * - items: A list of items.
 * - title: The title of the list.
 * - list_type: The tag for list element ("ul" or "ol").
 * - wrapper_attributes: HTML attributes for list wrapper.
 * - attributes: HTML attributes for the list.
 * - empty: A message to display when there are no items.
 * - facet: The facet for this result item.
 * - facet_vocab_group: Optional mapped vocabulary group metadata for title.
 */
#}
{% if cache_hash %}
  <!-- facets cacheable metadata
    hash: {{ cache_hash }}
  {% if cache_contexts %}
    contexts: {{ cache_contexts }}
  {%- endif %}
  {% if cache_tags %}
    tags: {{ cache_tags }}
  {%- endif %}
  {% if cache_max_age %}
    max age: {{ cache_max_age }}
  {%- endif %}
  -->
{%- endif %}
{% if facet.widget.type == 'checkbox' %}
  {% set item_classes = 'js-form-item js-form-type-checkbox checkbox form-check' %}
{% endif %}
<div class="facets-widget- {{- facet.widget.type -}} ">
  {% if facet.widget.type %}
    {%- set attributes = attributes.addClass('item-list__' ~ facet.widget.type) %}
  {% endif %}
  {% if items or empty %}
    {%- if title is not empty -%}
      <h3>
        <span>{{ title }}</span>
        {% if facet_vocab_group is defined and facet_vocab_group.popover_id is not empty %}
          {% set trigger_label = 'Show vocabulary information for @label'|t({'@label': title}) %}
          <button
            type="button"
            class="metsis-vocab-popover-trigger metsis-facet-vocab-popover-trigger"
            popovertarget="{{ facet_vocab_group.popover_id }}"
            data-popover-target="{{ facet_vocab_group.popover_id }}"
            aria-expanded="false"
            aria-controls="{{ facet_vocab_group.popover_id }}"
            aria-label="{{ trigger_label }}"
          >
            {{ icon('metsis_drupal', 'circle-info', {'size': '14'}) }}
          </button>
          <div
            id="{{ facet_vocab_group.popover_id }}"
            class="metsis-vocab-popover"
            role="tooltip"
            popover="auto"
            hidden
          >
            {% if facet_vocab_group.label is not empty %}
              <p class="metsis-vocab-popover__title">{{ facet_vocab_group.label }}</p>
            {% endif %}
            {% if facet_vocab_group.definition is not empty %}
              <p>{{ facet_vocab_group.definition }}</p>
            {% endif %}
            {% if facet_vocab_group.uri is not empty %}
              <p>
                <a
                  href="{{ facet_vocab_group.uri }}"
                  target="_blank"
                  rel="noopener noreferrer nofollow"
                >
                  {{ 'Vocabulary reference'|t }}
                </a>
              </p>
            {% endif %}
          </div>
        {% endif %}
      </h3>
    {%- endif -%}

    {%- if items -%}
      <{{ list_type }}{{ attributes }}>
        {%- for item in items -%}
          <li{{ item.attributes.addClass(item_classes) }}>{{ item.value }}</li>
        {%- endfor -%}
      </{{ list_type }}>
    {%- else -%}
      {{- empty -}}
    {%- endif -%}
  {%- endif %}

{% if facet.widget.type == "dropdown" %}
  <label id="facet_{{ facet.id }}_label">{{ 'Facet'|t }} {{ facet.label }}</label>
{%- endif %}
</div>
