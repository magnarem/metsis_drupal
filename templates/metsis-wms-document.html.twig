{#
/**
 * @file
 * Theme for rendering WMS capability endpoints and the map app mount point.
 */
#}
<article class="metsis-metadata" aria-labelledby="{% if not inline_mode %}metsis-wms-title{% else %}metsis-wms-map-heading{% endif %}">
  {% if not inline_mode %}
    <header class="metsis-metadata__header">
      <p class="metsis-metadata__eyebrow">WMS visualization</p>
      <h1 id="metsis-wms-title" class="metsis-metadata__title">{{ title }}</h1>
      <p class="metsis-metadata__abstract"><em>{{ metadata_identifier }}</em></p>
    </header>
  {% endif %}

  <section class="metsis-metadata__section" aria-labelledby="metsis-wms-map-heading">
    <h2 id="metsis-wms-map-heading" {% if inline_mode %}class="visually-hidden"{% endif %}>Map</h2>
    {% if inline_mode %}
      <div class="metsis-wms-inline-shell">
        <div class="metsis-wms-inline-actions">
          <button type="button" class="metsis-close-button" data-metsis-wms-close aria-label="Close WMS visualization">&times;</button>
        </div>
        <div id="{{ mount_id|default('metsis-map-app') }}" class="metsis-wms-map"></div>
      </div>
    {% else %}
      <div id="{{ mount_id|default('metsis-map-app') }}" class="metsis-wms-map"></div>
    {% endif %}
  </section>

  {% if not inline_mode or wms_endpoints|length > 1 %}
    <section class="metsis-metadata__section" aria-labelledby="metsis-wms-endpoints-heading">
      <h2 id="metsis-wms-endpoints-heading">Available WMS endpoints</h2>
      {% if wms_endpoints %}
        <ul>
          {% for endpoint in wms_endpoints %}
            <li>
              <strong>{{ endpoint.label }}</strong><br>
              <a href="{{ endpoint.capabilitiesUrl }}" target="_blank" rel="noopener noreferrer">Capabilities document</a>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p>No OGC WMS endpoints were found for this metadata document.</p>
      {% endif %}
    </section>
  {% endif %}
</article>
