{#
/**
 * @file
 * HTMX response wrapper for metadata dialog content.
 */
#}
<dialog class="metsis-metadata-dialog" data-metsis-metadata-dialog>
  <header class="metsis-metadata-dialog__header">
    <h2 class="metsis-metadata-dialog__title">Metadata Record</h2>
    <button type="button" class="metsis-metadata-dialog__close" data-metsis-dialog-close aria-label="Close metadata dialog">&times;</button>
  </header>
  <div class="metsis-metadata-dialog__body">
    {{ content }}
  </div>
</dialog>
