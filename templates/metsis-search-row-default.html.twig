{#
/**
 * @file
 * Default view template to display all the fields in a row.
 *
 * Available variables:
 * - view: The view in use.
 * - row: The raw result from the query, with all data it fetched.
 * - options: The options array passed to the row plugin.
 * - solr_doc: The Solr document fields for the current result.
 * - fields: An array of preprared/processed field values.
 * - excerpt: An array of highlighted/excerpted field snippets.
 * - highlighted: An array of highlighted field values.
 *
 * @see MetsisSearchRow views row plugin.
 *
 * @ingroup themeable
 */
#}
{{ attach_library('metsis_drupal/metsis_default_row_layout') }}
{# {{ dump(highlighted) }} #}
{# {{ dump(solr_doc['personnel_json']) }} #}
{% set icon_alignment = 'right' %}
	<article id="{{ fields.id }}" class="metsis-search-row"> <div id="metadata-identifier" class="hidden" hidden>{{ fields.metadata_identifier }}</div>
	<div class="metsis-search-title">
		{% if fields.landing_page is not empty %}
			<a href="{{ fields.landing_page }}" target="_blank" rel="noopener" title="Go to dataset landing page (opens in a new window)" aria-label="Go to dataset landing page">{{ fields.title }}
				<span class="sr-only">(opens in a new window)</span>
			</a>
		{% else %}
			{{ fields.title }}
		{% endif %}
	</div>
	{% if solr_doc is defined and solr_doc is not empty %}
		{% set solr_meta_fields = [
			{
				'label': 'Last metadata update',
				'singular_label': null,
				'field': 'last_metadata_updated_date',
				'render_field': 'last_metadata_update'
			},
      {
				'label': 'Projects',
				'singular_label': 'Project',
				'field': 'project_name',
				'render_field': null
			},
			{
				'label': 'Institutions',
				'singular_label': 'Institution',
				'field': 'personnel_organisation',
				'render_field': null
			},
      {
				'label': 'Platforms',
				'singular_label': 'Platform',
				'field': 'platform_name',
				'render_field': null
			},
      {
				'label': 'Instruments',
				'singular_label': 'Instrument',
				'field': 'platform_instrument_name',
				'render_field': null
			}
		] %}
		<div class="metsis-solr-meta" aria-label="Additional dataset metadata">
			{% for item in solr_meta_fields %}
				{% set highlighted_value = highlighted[item.field] ?? null %}
				{% set preferred_field = item.render_field ?? null %}
				{% set preferred_value = preferred_field is not empty ? (fields[preferred_field] ?? null) : null %}
				{% set raw_value = preferred_value is not empty ? preferred_value : (highlighted_value is not empty ? highlighted_value : (solr_doc[item.field] ?? null)) %}
				{% if raw_value is not empty %}
					{% set output_label = item.label %}
					{% set original_value = solr_doc[item.field] ?? null %}
					{% if item.singular_label is not empty and original_value is iterable and original_value|length == 1 %}
						{% set output_label = item.singular_label %}
					{% endif %}
					{% set is_highlighted = highlighted_value is not empty %}
					{% set rendered_value = raw_value is iterable ? raw_value|join(', ') : raw_value %}
					<div class="metsis-solr-meta-item">
						<span class="metsis-solr-meta-label">{{ output_label }}:</span>
						<span class="metsis-solr-meta-value">{{ is_highlighted ? rendered_value|raw : rendered_value }}</span>
					</div>
				{% endif %}
			{% endfor %}
		</div>
	{% endif %}
	{{ fields.temporal_extent }}
	<div class="metsis-search-main">
		{% if fields.thumbnail is defined and fields.thumbnail is not empty %}
			<div class="metsis-map-figure">
				{{ fields.thumbnail }}
			</div>
		{% elseif fields.leaflet_map is defined and fields.leaflet_map is not empty %}
			<div class="metsis-map-figure">
				{{ fields.leaflet_map }}
			</div>
		{% endif %}
		<div class="metsis-search-content">
			{{ excerpt }}
			<div class="metsis-search-quote">
				{% if highlighted.abstract_hl is defined and highlighted.abstract_hl is not empty %}
					{{ highlighted.abstract_hl[0]|raw }}
				{% else %}
					{{ fields.abstract }}
				{% endif %}
			</div>
		</div>
		<div class="metsis-icon-wrapper metsis-icon-wrapper--align-{{ icon_alignment }}">
			{% if fields.doi_icon %}
				{{ fields.doi_icon }}
			{% endif %}

			{% if fields.parent is defined and fields.parent is not empty %}
				<div class="metsis-collection-image">
					{% include 'metsis_drupal:collection' with {
						icon_alt_text: 'Collection',
            color: '#0053a6',
            width: 88,

					} only %}
				</div>
			{% endif %}

			{% if fields.license_icon is defined and fields.license_icon is not empty %}
				<div class="metsis-license-icon-slot">
					{{ fields.license_icon }}
				</div>
			{% endif %}
		</div>
	</div>
	{% if operations is defined and operations is not empty %}
		<div class="metsis-row-operations-wrapper">
			{{ operations }}
		</div>
	{% endif %}
</article>
