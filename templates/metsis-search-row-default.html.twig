{#
/**
 * @file
 * Default view template to display all the fields in a row.
 *
 * Available variables:
 * - view: The view in use.
 * - row: The raw result from the query, with all data it fetched.
 * - options: The options array passed to the row plugin.
 * - solr_doc: The Solr document fields for the current result.
 * - fields: An array of preprared/processed field values.
 * - excerpt: An array of highlighted/excerpted field snippets.
 * - highlighted: An array of highlighted field values.
 *
 * @see MetsisSearchRow views row plugin.
 *
 * @ingroup themeable
 */
#}
{{ attach_library('metsis_drupal/metsis_default_row_layout') }}
{# { dump(fields) } #}
{# { dump(highlighted) } #}
	<article id="{{ fields.id }}" class="metsis-search-row">
  <div id="metadata-identifier" class="hidden" hidden>{{ fields.metadata_identifier }}</div>
  <div class="metsis-search-title">
		{% if fields.landing_page is not empty %}
			<a href="{{ fields.landing_page }}" target="_blank" rel="noopener" title="Go to dataset landing page (opens in a new window)" aria-label="Go to dataset landing page">{{ fields.title }}
				<span class="sr-only">(opens in a new window)</span>
			</a>
		{% else %}
			{{ fields.title }}
		{% endif %}
	</div>
  {{ fields.temporal_extent }}
	<div class="metsis-search-main">
		{% if fields.thumbnail is defined and fields.thumbnail is not empty %}
			<div class="metsis-map-figure">
				{{ fields.thumbnail }}
			</div>
		{% elseif fields.leaflet_map is defined and fields.leaflet_map is not empty %}
			<div class="metsis-map-figure">
				{{ fields.leaflet_map }}
			</div>
		{% endif %}
		<div class="metsis-search-content">
			{{ excerpt }}
			<div class="metsis-search-quote">
				{{ fields.abstract }}
			</div>
		</div>
		<div class="metsis-icon-wrapper">
			{% if fields.doi_icon %}
				{{ fields.doi_icon }}
			{% endif %}

			{% if fields.license_icon is defined and fields.license_icon is not empty %}
				{{ fields.license_icon }}
			{% endif %}
			{% if fields.parent is defined and fields.parent is not empty %}
				<div class="metsis-collection-image">
					{{ fields.parent }}
					<button class="metsis-collection-button" title="Filter on this collection" data-collection-id="{{ fields.metadata_identifier }}">
						<svg width="24px" height="24px" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M21 6H19M21 12H16M21 18H16M7 20V13.5612C7 13.3532 7 13.2492 6.97958 13.1497C6.96147 13.0615 6.93151 12.9761 6.89052 12.8958C6.84431 12.8054 6.77934 12.7242 6.64939 12.5617L3.35061 8.43826C3.22066 8.27583 3.15569 8.19461 3.10948 8.10417C3.06849 8.02393 3.03853 7.93852 3.02042 7.85026C3 7.75078 3 7.64677 3 7.43875V5.6C3 5.03995 3 4.75992 3.10899 4.54601C3.20487 4.35785 3.35785 4.20487 3.54601 4.10899C3.75992 4 4.03995 4 4.6 4H13.4C13.9601 4 14.2401 4 14.454 4.10899C14.6422 4.20487 14.7951 4.35785 14.891 4.54601C15 4.75992 15 5.03995 15 5.6V7.43875C15 7.64677 15 7.75078 14.9796 7.85026C14.9615 7.93852 14.9315 8.02393 14.8905 8.10417C14.8443 8.19461 14.7793 8.27583 14.6494 8.43826L11.3506 12.5617C11.2207 12.7242 11.1557 12.8054 11.1095 12.8958C11.0685 12.9761 11.0385 13.0615 11.0204 13.1497C11 13.2492 11 13.3532 11 13.5612V17L7 20Z" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
						{{ fields.children_count }}<span class="children-sub-text">children found</span>
					</button>

				</div>
			{% endif %}

		</div>

	</div>
</article>
