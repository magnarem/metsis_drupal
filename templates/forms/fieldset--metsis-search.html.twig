{#
/**
 * @file
 * Scoped fieldset template for METSIS search exposed form.
 *
 * Keeps Drupal fieldset semantics while adding a structured header row
 * for modern card-like presentation and optional vocab popover trigger.
 */
#}

{% set classes = [
    'metsis-search-fieldset',
    'js-form-item',
    'form-item',
    'js-form-wrapper',
    'form-wrapper',
  ]
%}
<fieldset{{ attributes.addClass(classes) }}>
	{% set legend_span_classes = [
      'fieldset-legend',
      required ? 'js-form-required',
      required ? 'form-required',
      'metsis-search-fieldset__title',
    ] %}
	<legend{{ legend.attributes.addClass('metsis-search-fieldset__legend') }}>
		<span class="metsis-search-fieldset__header">
			<span{{ legend_span.attributes.addClass(legend_span_classes) }}>{{ legend.title }}</span>
			{% if metsis_vocab_popover is defined %}
				{{ metsis_vocab_popover }}
			{% endif %}
		</span>
	</legend>
	<div class="fieldset-wrapper metsis-search-fieldset__body">
		{% if description_display == 'before' and description.content %}
			<div{{ description.attributes.addClass('description') }}>{{ description.content }}</div>
		{% endif %}
		{% if errors %}
			<div>
				{{ errors }}
			</div>
		{% endif %}
		{% if prefix %}
			<span class="field-prefix">{{ prefix }}</span>
		{% endif %}
		{{ children }}
		{% if suffix %}
			<span class="field-suffix">{{ suffix }}</span>
		{% endif %}
		{% if description_display in ['after', 'invisible'] and description.content %}
			<div{{ description.attributes.addClass('description') }}>{{ description.content }}</div>
		{% endif %}
	</div>
</fieldset>
