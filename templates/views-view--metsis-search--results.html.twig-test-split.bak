      <!-- Facet Filters -->
      <h3>Filters</h3>
      {% if exposed %}
          {{ exposed }}
      {% endif %}
    </div>

  </aside>

  <!-- Right Column: Search Bar, Map, and Results -->
  <div class="metsis-search-main-content">
    <div class="{{ metsisSearchBarClasses|join(' ') }}">
      <!-- Search Bar and Exposed Filters -->


<!--
        <form>
        {{ exposed.search_api_fulltext }}

       {{ exposed.form_token }}
     {{ exposed.form_build_id }}
     {{ exposed.form_id }}

     {{exposed.actions }}
    </form>

    </div>
-->
    <div class="metsis-map-container-wrapper">
      <!-- Map -->
      <div id="metsis-map-app" class="metsis-map-container"></div>
    </div>

    <div class="metsis-results-header">

      <!-- Results Header -->
      {% if pager %}
		{{ pager }}
	    {% endif %}

      <!-- Add additional results information here -->
    </div>

    <div class="metsis-results-content">
      <!-- Views Results Content -->
      <!-- Add your search results here -->
      {% if rows %}
		<div class="metsis-view-content">
			{{ rows }}
		</div>
	{% elseif empty %}
		<div class="view-empty">
			{{ empty }}
		</div>
	{% endif %}
    </div>
    {% if pager %}
		{{ pager }}
	{% endif %}
    {% if footer %}
		<div class="view-footer">
			{{ footer }}
		</div>
	{% endif %}
	{% if feed_icons %}
		<div class="feed-icons">
			{{ feed_icons }}
