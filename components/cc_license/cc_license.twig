{% set icon_width = width|default(88) %}
{% set license_label = icon_alt_text|default(license_id) %}
<div {{ attributes.addClass('cc-license-wrapper').setAttribute('style', '--cc-icon-width: ' ~ icon_width ~ ';') }}>
  <a href="{{ license_url }}"
     title="{{ license_label }} License"
     target="_blank"
     rel="noopener noreferrer"
     class="cc-license-link"
     aria-label="{{ license_label }} License (opens in new window)"> <!-- Accessible aria-label -->
    <span class="visually-hidden">{{ license_label }} License</span> <!-- Hidden text for screen readers -->
    {{ icon('metsis_drupal_cc', icon_id, {'width': icon_width}) }}
  </a>
</div>
