{% set size = icon_size|default(20) %}
<div {{ attributes.addClass('collection-filter-button') }} style="--cfb-icon-size: {{ size }}px;">
  {#
    Icon is overlaid on top of the themed <input> using absolute positioning.
    The input keeps all its theme classes; we only add padding-left to make room.
    The original SVG also lives at assets/icons/filter-parent.svg for other usages.
  #}
  <span class="collection-filter-button__icon" aria-hidden="true">
    {{ icon('metsis_drupal', 'filter-parent', {size: size}) }}
  </span>
  {% block button %}{% endblock %}
</div>
