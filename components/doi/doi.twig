{% set show_doi = show_doi_identifier|default(false) %}
{% set classes = 'doi-icon-wrapper' %}
{% set icon_size = size|default(32) %}
{% set identifier = doi_url|replace({'https://doi.org/': ''}) %}
<div {{ attributes.addClass(classes) }}>

<a href="{{ doi_url }}"
  aria-label="DOI Link"
  title="Open link (opens in a new window)"
  rel="noopener, noreferrer"
  target="blank">
  {{ icon('metsis_drupal', 'doi', {'size': icon_size}) }}
  {% if show_doi %}
  <span class="doi-identifier">{{ identifier }}</span>
  {% endif %}
  </a>
</div>
