{% set classes = 'doi-icon-wrapper' %}
{% set icon_size = size|default(24) %}
{% set use_color = color is not null ? color : true %}
{% set identifier = doi_url|replace({'https://doi.org/': ''}) %}
<div {{ attributes.addClass(classes).setAttribute('style', '--doi-icon-size: ' ~ icon_size ~ ';') }}>

<a href="{{ doi_url }}"
  aria-label="DOI Link"
  title="Open link (opens in a new window)"
  rel="noopener, noreferrer"
  target="blank">
  {% if use_color %}
  {{ icon('metsis_drupal', 'doi', {'size': icon_size}) }}
  {% else %}
  {{ icon('metsis_drupal', 'doi-black', {'size': icon_size}) }}
  {% endif %}
  {% if show_doi_identifier %}
  <span class="doi-identifier">{{ identifier }}</span>
  {% endif %}
  </a>
</div>
