{
    "name": "metno/metsis_drupal",
    "type": "drupal-custom-module",
    "description": "METSIS drupal modules",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Magnar Martinsen",
            "email": "magnarem@met.no"
        }
    ],
    "scripts": {
        "sniff": "phpcs",
        "snifferfix": "phpcbf"
    },
    "minimum-stability": "alpha",
    "prefer-stable": true,
    "require": {
        "ext-dom": "*",
        "ext-json": "*",
        "ext-simplexml": "*",
        "drupal/search_api": "^1.39",
        "drupal/search_api_solr": "^4.3",
        "drupal/search_api_solr_nlp": "^1.1",
        "drupal/facets": "^3.0",
        "drupal/search_api_autocomplete": "^1.10",
        "drupal/better_exposed_filters": "^7.1@beta",
        "drupal/redis": "^1",
        "drupal/leaflet": "^10.3",
        "drupal/geofield": "^1",
        "drupal/views_ajax_history": "^1.8",
        "drupal/views_filters_summary": "^3.2"
    },
    "suggest": {
        "drupal/back_to_top": "Add back to top icon on scrolling",
        "drupal/ext_link": "Add icon to external links",
        "drupal/markdown": "Enable Markdown support"
    },
    "require-dev": {
        "drupal/devel": "^4.0 || ^5.0",
        "drush/drush": "^13",
        "drupal/webprofiler": "^11",
        "drupal/config_devel": "^1.10",
        "drupal/log_stdout": "^3.0",
        "kint-php/kint": "^6",
        "firephp/firephp-core": "^0.5.3",
        "symfony/var-dumper": "^4 || ^5 || ^6 || ^7",
        "drupal/kint-kint": "^2.1",
        "drupal/vite": "^1.5",
        "drupal/core-dev": "^10.5 || ^11",
        "drupal/pathauto": "^1.13",
        "phpunit/php-code-coverage": "^9.2 || ^10.0 || ^11.0 || ^12.0",
        "drupal/gin": "^5.0",
        "drupal/gin_toolbar": "^3.0",
        "drupal/default_content": "^2.0@alpha",
        "drupal/htmx": "^1.5",
        "friendsoftwig/twigcs": "*",
        "drupal/solo": "^1.0",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true,
            "drupalspoons/composer-plugin": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": true,
            "tbachert/spi": true,
            "wikimedia/composer-merge-plugin": true
        }
    }
}
